namespace Baitap
{
    public partial class Form1 : Form
    {

        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            lblTrangThai.Text = "Sẵn sàng. Hãy chạy Migration trước khi dùng (xem README.md).";

        }
    

    private void LoadDanhSach()
        {
            using (var db = new AppDbContext())
            {
                var ds = db.Students.ToList();

                dgvSinhVien.DataSource = ds;
            }

            lblTrangThai.Text = "Đã tải danh sách sinh viên";
        }


        private void btnThem_Click(object sender, EventArgs e)
        {
            if (txtHoTen.Text.Trim() == "")
            {
                MessageBox.Show("Vui lòng nhập họ tên!");
                return;
            }

            if (!double.TryParse(txtDiem.Text, out double diem))
            {
                MessageBox.Show("Điểm phải là số!");
                return;
            }

            if (diem < 0 || diem > 10)
            {
                MessageBox.Show("Điểm phải từ 0 đến 10!");
                return;
            }

            using (var db = new AppDbContext())
            {
                Student sv = new Student
                {
                    HoTen = txtHoTen.Text.Trim(),
                    Diem = diem
                };

                db.Students.Add(sv);
                db.SaveChanges();
            }

            MessageBox.Show("Thêm sinh viên thành công!");

            LoadDanhSach();
            XoaTrang();
        }


  
        private void btnSua_Click(object sender, EventArgs e)
        {
            if (dgvSinhVien.CurrentRow == null)
            {
                MessageBox.Show("Vui lòng chọn sinh viên cần sửa!");
                return;
            }

            if (txtHoTen.Text.Trim() == "")
            {
                MessageBox.Show("Vui lòng nhập họ tên!");
                return;
            }

            if (!double.TryParse(txtDiem.Text, out double diem))
            {
                MessageBox.Show("Điểm phải là số!");
                return;
            }

            if (diem < 0 || diem > 10)
            {
                MessageBox.Show("Điểm phải từ 0 đến 10!");
                return;
            }

            int id = Convert.ToInt32(
                dgvSinhVien.CurrentRow.Cells["Id"].Value
            );

            using (var db = new AppDbContext())
            {
                Student sv = db.Students.Find(id);

                if (sv != null)
                {
                    sv.HoTen = txtHoTen.Text.Trim();
                    sv.Diem = diem;

                    db.SaveChanges();
                }
            }

            MessageBox.Show("Sửa sinh viên thành công!");

            LoadDanhSach();
            XoaTrang();
        }


     
        private void btnXoa_Click(object sender, EventArgs e)
        {
            if (dgvSinhVien.CurrentRow == null)
            {
                MessageBox.Show("Vui lòng chọn sinh viên cần xóa!");
                return;
            }

            DialogResult result = MessageBox.Show(
                "Bạn có chắc muốn xóa sinh viên này?",
                "Xác nhận",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Question
            );

            if (result == DialogResult.No)
                return;

            int id = Convert.ToInt32(
                dgvSinhVien.CurrentRow.Cells["Id"].Value
            );

            using (var db = new AppDbContext())
            {
                Student sv = db.Students.Find(id);

                if (sv != null)
                {
                    db.Students.Remove(sv);
                    db.SaveChanges();
                }
            }

            MessageBox.Show("Xóa sinh viên thành công!");

            LoadDanhSach();
            XoaTrang();
        }


        
        private void btnTaiLai_Click(object sender, EventArgs e)
        {
            LoadDanhSach();
            XoaTrang();
        }


        private void btnLoc_Click(object sender, EventArgs e)
        {
            using (var db = new AppDbContext())
            {
                var ds = db.Students
                           .Where(s => s.Diem >= 5)
                           .ToList();

                dgvSinhVien.DataSource = ds;

                lblTrangThai.Text =
                    "Đang hiển thị sinh viên đạt (điểm >= 5)";
            }
        }


        private void dgvSinhVien_CellClick(
            object sender,
            DataGridViewCellEventArgs e)
        {
            if (e.RowIndex >= 0)
            {
                DataGridViewRow row =
                    dgvSinhVien.Rows[e.RowIndex];

                txtHoTen.Text =
                    row.Cells["HoTen"].Value?.ToString();

                txtDiem.Text =
                    row.Cells["Diem"].Value?.ToString();
            }
        }

    
        private void XoaTrang()
        {
            txtHoTen.Clear();
            txtDiem.Clear();

            txtHoTen.Focus();
        }
    }
}

